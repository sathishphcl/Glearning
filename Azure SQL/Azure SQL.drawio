                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-0" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="60" y="80" width="686" height="385.11" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="790" y="80" width="839" height="603" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-2" value="&lt;span style=&quot;box-sizing: border-box; font-weight: 700; color: rgb(74, 71, 75); font-family: Lato, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Backup Package&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="1470" y="683" width="140" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-3" value="&lt;span style=&quot;box-sizing: border-box; font-weight: 700; color: rgb(74, 71, 75); font-family: Lato, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Data-Tier Application Package&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="1190" y="683" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-4" value="&lt;span style=&quot;color: rgb(74, 71, 75); font-family: Lato, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;include EXTRACT, &lt;br&gt;DEPLOY, &lt;br&gt;REGISTER, &lt;br&gt;UNREGISTER, &lt;br&gt;UPGRADE&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="1235" y="710" width="150" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-5" value="&lt;span style=&quot;color: rgb(74, 71, 75); font-family: Lato, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;include EXPORT, &lt;br&gt;IMPORT&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="1480" y="720" width="140" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-7" value="&lt;div&gt;The &lt;b&gt;&lt;u&gt;primary use case for a DACPAC is to deploy a tightly defined schema&lt;/u&gt;&lt;/b&gt; to development, test, and then production environments, capture the production’s schema and apply it back to test and development environments.&lt;/div&gt;&lt;div&gt;However, &lt;b&gt;&lt;u&gt;the primary use case for a BACPAC is to move a database from one server to another—or to migrate a database from a local server to the cloud&lt;/u&gt;&lt;/b&gt;—and archive an existing database in an open format.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="153" y="570" width="500" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-9" value="Export &amp;amp; Import&lt;br&gt;backup &amp;amp; Restore&lt;br&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="760" y="790" width="210" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ZFNVtlZeEmkXz9uu0L0y-10" value="https://4sysops.com/archives/dacpac-and-bacpac-in-sql-server/&lt;br&gt;https://www.mssqltips.com/" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="80" y="1010" width="690" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="yHRXb5MyYAiTw-lcYbXg-0" value="The schema defines the structure of a database and outlines the tables and fields, including the relationships between them, and other data elements necessary to accurately access and update information stored within.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" parent="QiCNzljQoQfZWej0GKWY-1" vertex="1">
                    <mxGeometry x="60" y="-60" width="1570" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
